# ═══════════════════════════════════════════════════════════════════
#  نَبّهني — متغيّرات البيئة
#  انسخ هذا الملف إلى .env وعدّل القيم حسب حاجتك.
# ═══════════════════════════════════════════════════════════════════

# ── أساسي ──────────────────────────────────────────────────────────
# مسار ملف قاعدة البيانات (SQLite). للإنتاج استخدم مسارًا على قرص دائم.
DATABASE_FILE="./data/nabbihni.db"

# مفتاح توقيع الجلسات — ٣٢ حرفًا فأكثر. إلزامي في الإنتاج.
# ولّد واحدًا: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="dev-secret-change-me-in-production-please-0123456789"

# عنوان التطبيق (يُستخدم في روابط البريد)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── الإشعارات الدافعة (اختياري) ────────────────────────────────────
# التطبيق يعمل بدونها عبر إشعارات المتصفح المحلية.
# لتفعيل الإشعارات والتطبيق مغلق:  npm run generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@nabbihni.app"

# ── البريد الإلكتروني ──────────────────────────────────────────────
# console = يطبع الرسالة في الطرفية (مثالي للتطوير، تعمل به روابط التفعيل)
# resend  = إرسال حقيقي عبر Resend
EMAIL_PROVIDER="console"
EMAIL_FROM="نَبّهني <no-reply@nabbihni.app>"
RESEND_API_KEY=""

# ── المساعد الذكي ──────────────────────────────────────────────────
# local = محلّل عربي داخلي بلا مفاتيح (الافتراضي، يعمل فورًا)
# anthropic أو openai = نموذج لغوي خارجي
AI_PROVIDER="local"
AI_API_KEY=""
AI_MODEL=""

# ── المجدول ────────────────────────────────────────────────────────
# رمز يحمي /api/cron/dispatch من الاستدعاء العلني
CRON_SECRET="dev-cron-secret"
