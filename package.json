  "private": true,
  "description": "نَبّهني — منصة ذكية لإدارة المهام والمواعيد والتذكيرات والعادات",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
